{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HRIDAY DocumentInput",
  "type": "object",
  "required": ["document_id", "source_type"],
  "properties": {
    "document_id": {"type": "string"},
    "source_type": {"enum": ["pdf", "png", "jpg", "scan"]},
    "page_count": {"type": ["integer", "null"], "minimum": 1}
  }
}
